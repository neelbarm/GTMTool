# Copy to .env and fill in. Never commit .env.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The single number all test calls are placed from, E.164.
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=

# https base URL of your tunnel, no trailing slash, e.g. https://abc123.ngrok.app
PUBLIC_BASE_URL=

# The assessment line. This is also hard-coded in app/config.py as ASSESSMENT_LINE;
# if the two disagree the app refuses to start. Changing it here does not unlock
# dialing anywhere else.
ALLOWED_DESTINATION=+18054398008

# gpt-realtime-2.1 improves interruption handling and noise robustness over
# gpt-realtime-2, which matters on a phone line. gpt-realtime-2.1-mini is cheaper
# and fine for plumbing dry-runs.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=cedar

# Post-call analysis pass. Any chat model your key can reach.
EVALUATOR_MODEL=gpt-4.1

ARTIFACTS_DIR=artifacts/calls
MAX_CALL_SECONDS=240
